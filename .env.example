# Copie este arquivo para .env e preencha com os valores reais.
# .env nao deve ser commitado (ja esta no .gitignore).

# URL final de producao, sem barra no final.
# Usada por scripts/set-site-url.js para preencher canonical, Open Graph,
# sitemap.xml e dados estruturados (JSON-LD) em todo o site.
SITE_URL=https://dominiofinal.com.br

# Opcional — preencher quando as contas forem criadas.
# Nao inventar IDs: deixar em branco ate existirem de fato.
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
BING_WEBMASTER_VERIFICATION=
